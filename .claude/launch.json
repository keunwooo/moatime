{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191
    },
    {
      "name": "moa-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "moa-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "moa-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-pages",
        "--base",
        "/moatime/",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181,
      "url": "http://localhost:5181"
    }
  ]
}